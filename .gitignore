/coverage

# production
/build

# misc
.DS_Store
.env
.tmp.driveupload/*

# Cursor IDE — never commit local MCP config, debug logs, or secrets
.cursor/
# .claude/ is no longer blanket-ignored — commands/ and skills/ are now
# committed so cloud/mobile Claude Code sessions can use them. Only the
# machine-local noise below stays excluded.
.claude/settings.local.json
.claude/worktrees/
.claude/*.log
.claude/.DS_Store
.claude/settings.json
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.log
# Local MCP secrets (never copy into repo)
**/mcp-secrets.env


# aptro/superset-mcp — install with scripts/install-superset-mcp.sh (clone + venv)
/third_party/superset-mcp/

# backend (when run from backend/)
backend/node_modules
backend/data
backend/agent-exports
backend/.tmp_*.mjs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#Aplha frotend
alpha-web-ui/tsconfig.tsbuildinfo

#selected pages
pdfParser copy.js
server copy.js
/src/app copy 2.js
/src/prd-agent-v7 copy 2.jsx
/src/uat-agent1 copy.jsx
/src/prd-agent-v7 copy.jsx
/src/uat-agent1 copy 2.jsx
