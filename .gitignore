# JIRA agent generated output (sample RRNs, escalation drafts)
JIRA-agent/output/

# Local Jira MCP server (tool code + node_modules, not part of the app)
mcp/jira-mcp/

# Premium workspace: briefs and local runs stay on this machine
premium/artifacts/briefs/
premium/artifacts/data/
premium/sessions/*.md
